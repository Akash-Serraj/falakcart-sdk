{
    "name": "@falakcart/sdk",
    "version": "1.0.1",
    "description": "FalakCart storefront SDK — typed access to the window.falak runtime the platform injects into every storefront.",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "main": "./npm/index.js",
    "module": "./npm/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./npm/index.js"
        },
        "./falak-sdk.js": "./dist/falak-sdk.js",
        "./package.json": "./package.json"
    },
    "unpkg": "./dist/falak-sdk.js",
    "jsdelivr": "./dist/falak-sdk.js",
    "files": [
        "npm",
        "types",
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "keywords": [
        "falakcart",
        "storefront",
        "sdk",
        "ecommerce",
        "themes"
    ],
    "homepage": "https://falakcart.sa",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch --mode development",
        "test": "vitest run"
    },
    "devDependencies": {
        "vite": "7.1.2",
        "vitest": "^3.2.7"
    }
}
